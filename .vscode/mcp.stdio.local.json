{
  "inputs": [
    {
      "type": "promptString",
      "id": "consoleapp-project-path",
      "description": "The absolute path to the console app project Directory"
    }
  ],
  "servers": {
    "mcp-ksef": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${input:consoleapp-project-path}"
      ],
      "env": {
        "KSEF_TOKEN": "enter ksef token",
        "KSEF_VATID": "enter vat id"
      }
    }
  }
}
